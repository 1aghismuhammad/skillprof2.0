# ==========================================
# SkillProof - Root .gitignore
# Mendukung struktur monorepo / backend + frontend
# ==========================================

# 1. Dependencies (Root & Subfolders)
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Environment Variables & Secrets
# Abaikan semua file .env lokal, KECUALI .env.example sebagai referensi
.env
.env*.local
.env.development
.env.production
.env.test
**/.env
**/.env*.local
**/.env.development
**/.env.production
**/.env.test
!**/.env.example
*.pem
*.key
*.cert

# 3. Build & Bundler Artifacts (Next.js / Vite / React)
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# 4. Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# 5. Testing & Coverage
coverage/
**/coverage/
*.lcov
.nyc_output

# 6. Caches
.cache/
**/.cache/
.turbo/
**/.turbo/
.eslintcache
.stylelintcache

# 7. TypeScript
*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# 8. Platform Deployments
.vercel/
**/.vercel/

# 9. IDE & Editor Artifacts
.idea/
**/.idea/
.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 10. Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
